# DeepAICode2API 注册链路配置（复制为 .env 后填写）
#
# Hotmail / Outlook Graph 邮箱文件，每行：邮箱----密码----client_id----refresh_token
# 文件包含敏感凭据，请妥善保管；控制台可直接导入邮箱文件。
DEEPAI_GRAPH_MAIL_FILE=

# Google 号池从控制台导入，每行：邮箱----Google密码（企业 / 教育账号同样支持）。
# 自动检测 Chrome / Edge；以下可指定运行网关电脑上的浏览器可执行文件。
DEEPAI_GOOGLE_BROWSER=
# auto：Linux 没有 DISPLAY/WAYLAND_DISPLAY 时无头，桌面环境显示窗口。
# true：强制无头；false：显示窗口（Linux 可配 Xvfb/VNC）。
# 浏览器 Docker 镜像建议 false：容器内会自动启动 Xvfb 虚拟显示器。
DEEPAI_GOOGLE_HEADLESS=false
# 连续没有新授权进展时自动跳过当前账号；支持 30s、60s、2m，最长 10m。
DEEPAI_GOOGLE_IDLE_TIMEOUT=60s
# 可选：浏览器代理，仅支持不含账密的 http://host:port 或 socks5://host:port。
# 留空时沿用浏览器 / 操作系统网络配置；API 请求仍沿用现有 HTTP(S)_PROXY。
DEEPAI_GOOGLE_PROXY=

# ── 注册链路行为 ──────────────────────────────────────────────────
DEEPAI_REGISTER_LANGUAGE=en
DEEPAI_REGISTER_GROUP=default
DEEPAI_REGISTER_PROBE_MODEL=glm-5.3-flash

# ── 2API 网关 ─────────────────────────────────────────────────────
DEEPAI2API_GATEWAY=http://127.0.0.1:10087
DEEPAI2API_ADMIN_PASSWORD=
# 预构建镜像；仅调用 API 可改为 :latest，Google 登录使用 :latest-browser。
DEEPAI2API_IMAGE=ghcr.io/hl320217/deepaicode2api:latest-browser

# ── 容器 / 无 SMBIOS 环境必填 ─────────────────────────────────────
# 上游所有模型请求都要求 X-DeepAI-Code-Machine；填桌面端所在机器的原始 UUID。
DEEPAI_MACHINE_ID=

# ── 代理池（注册与推理共用）────────────────────────────────────────
# 完整 URL，逗号或换行分隔；每个账号轮询分配一个
PROXY_POOL=
# 或从文件读取（每行一个）
PROXY_POOL_FILE=
# 单个代理（覆盖代理池）
DEEPAI_REGISTER_PROXY=

# ── 安全默认值 ────────────────────────────────────────────────────
# 监听非回环地址（0.0.0.0 / 局域网 IP）时必须设置 DEEPAI2API_ADMIN_PASSWORD，
# 否则进程拒绝启动。确实要无密码运行才置 1（会把控制台暴露给整个网段）。
DEEPAI2API_ALLOW_INSECURE=

# ── 状态文件加密（P0-1）───────────────────────────────────────────
# 32 字节密钥，hex 或 base64；留空则状态文件以明文 JSON 落盘（会打警告）。
# 生成：openssl rand -hex 32
DEEPAI2API_MASTER_KEY=
